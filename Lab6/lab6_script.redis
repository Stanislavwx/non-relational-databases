# ==============================================================================
# Лабораторна робота №6: Робота з нереляційною моделлю NoSQL «ключ-значення» Redis
# Предметна область: Бібліотечна система (Варіант 6)
# Виконав: студент групи ФеП-32 Чепара Станіслав
# ЛНУ ім. Івана Франка, 2026
# ==============================================================================

# ==============================================================================
# ЗАВДАННЯ 1: Встановлення та налаштування Redis
# ==============================================================================

# 1.2. Перевірка працездатності сервера
PING

# 1.4. Аналіз основних параметрів сервера
INFO server
INFO memory

# ==============================================================================
# ЗАВДАННЯ 2: Базові операції CRUD з рядками (Strings)
# ==============================================================================

# 2.1. Створення 5 пар ключ-значення типу String
SET library:name "Центральна наукова бібліотека ім. Івана Франка"
SET library:address "вул. Драгоманова, 5, Львів"
SET library:working_hours "Пн-Пт: 09:00 - 18:00, Сб: 10:00 - 16:00"
SET library:phone "+380322394111"
SET library:website "https://library.lnu.edu.ua"

# 2.2. Прочитати створені значення за ключами
GET library:name
GET library:address
GET library:working_hours
GET library:phone
GET library:website

# 2.3. Оновити 2 значення
SET library:working_hours "Пн-Пт: 08:30 - 19:00, Сб: 10:00 - 17:00"
SET library:phone "+380322394222"

# 2.4. Видалити 1 пару ключ-значення
DEL library:website

# 2.5. Перевірити існування ключів
EXISTS library:name
EXISTS library:website

# 2.6. Отримати тип даних ключа
TYPE library:name

# ==============================================================================
# ЗАВДАННЯ 3: Робота з числами та лічильниками
# ==============================================================================

# 3.1. Створити лічильник зі значенням 0
SET library:stat:daily_visitors 0

# 3.2. Збільшити лічильник на 1 за допомогою INCR (10 разів)
INCR library:stat:daily_visitors
INCR library:stat:daily_visitors
INCR library:stat:daily_visitors
INCR library:stat:daily_visitors
INCR library:stat:daily_visitors
INCR library:stat:daily_visitors
INCR library:stat:daily_visitors
INCR library:stat:daily_visitors
INCR library:stat:daily_visitors
INCR library:stat:daily_visitors

# 3.3. Збільшити лічильник на довільне число (група відвідувачів)
INCRBY library:stat:daily_visitors 25

# 3.4. Зменшити лічильник на 1 (DECR) та на довільне число (DECRBY)
DECR library:stat:daily_visitors
DECRBY library:stat:daily_visitors 4

# 3.5. Створити лічильник з числом з плаваючою комою (вартість пені за прострочений день, грн)
SET library:finance:penalty_rate 2.50

# 3.6. Збільшити значення на дробове число
INCRBYFLOAT library:finance:penalty_rate 0.75

# 3.7. Створити 3-5 різних лічильників бібліотечної системи
SET library:stat:books_total 15420
SET library:stat:books_issued 340
SET library:stat:active_readers 1250
SET library:stat:new_acquisitions 45

# 3.8. Отримати всі значення лічильників одночасно
MGET library:stat:daily_visitors library:stat:books_total library:stat:books_issued library:stat:active_readers library:stat:new_acquisitions

# 3.9. Скинути один з лічильників до 0
SET library:stat:daily_visitors 0

# ==============================================================================
# ЗАВДАННЯ 4: Робота з часом життя (TTL)
# ==============================================================================

# 4.1. Створити ключ з TTL 300 секунд (5 хвилин) для кешу популярного пошукового запиту
SETEX library:cache:search:kobzar 300 "Тарас Шевченко - Кобзар, 1840"

# 4.2. Перевірити час життя ключа
TTL library:cache:search:kobzar

# 4.3. Продовжити час життя існуючого ключа до 600 секунд
EXPIRE library:cache:search:kobzar 600

# 4.4. Створити ключ з автоматичним видаленням через 20 секунд (одноразовий SMS-код читача)
SETEX library:auth:otp:reader1001 20 "948201"

# 4.5. Спостерігати за автоматичним видаленням ключа після закінчення TTL
TTL library:auth:otp:reader1001

# 4.6. Створити тимчасовий лічильник запитів з TTL (обмеження частоти запитів - rate limit)
SET library:ratelimit:ip:192.168.1.15 1 EX 60
INCR library:ratelimit:ip:192.168.1.15

# 4.7. Видалити TTL з ключа кешу (зробити його постійним) та перевірити результат
PERSIST library:cache:search:kobzar
TTL library:cache:search:kobzar

# ==============================================================================
# ЗАВДАННЯ 5: Робота зі списками (Lists)
# ==============================================================================

# 5.1. Створити список із 5 читачів у черзі на рідкісну книгу
RPUSH library:queue:book:101 "Читач #1001" "Читач #1002" "Читач #1003" "Читач #1004" "Читач #1005"

# 5.2. Додати термінового пільгового читача на початок черги (LPUSH)
LPUSH library:queue:book:101 "Читач #1000 (Пільговий)"

# 5.3. Додати нового читача у хвіст черги (RPUSH)
RPUSH library:queue:book:101 "Читач #1006"

# 5.4. Прочитати всі елементи списку
LRANGE library:queue:book:101 0 -1

# 5.5. Отримати та видалити перший елемент (обслуговування клієнта у черзі FIFO)
LPOP library:queue:book:101

# 5.6. Отримати та видалити останній елемент (стековий відкат LIFO)
RPOP library:queue:book:101

# 5.7. Знайти поточну довжину списку
LLEN library:queue:book:101

# 5.8. Отримати елемент за індексом 2 (третій у списку)
LINDEX library:queue:book:101 2

# 5.9. Видалити конкретного читача за значенням (відмова від бронювання)
LREM library:queue:book:101 1 "Читач #1003"

# ==============================================================================
# ЗАВДАННЯ 6: Робота з множинами (Sets)
# ==============================================================================

# 6.1. Створити дві множини жанрів: головного фонду та філії №1
SADD library:genres "поезія" "роман" "драма" "новела" "історична проза" "наукова література"
SADD library:branch1:genres "роман" "детектив" "фантастика" "драма" "наукова література" "дитяча література"

# 6.2. Додати нові елементи до множини
SADD library:genres "філософія" "біографія"

# 6.3. Переглянути всі елементи множин
SMEMBERS library:genres
SMEMBERS library:branch1:genres

# 6.4. Перевірити наявність конкретного елемента
SISMEMBER library:genres "поезія"
SISMEMBER library:genres "комікси"

# 6.5. Знайти перетин двох множин (спільні жанри для фонду і філії)
SINTER library:genres library:branch1:genres

# 6.6. Знайти обʼєднання двох множин (усі унікальні жанри мережі)
SUNION library:genres library:branch1:genres

# 6.7. Знайти різницю множин (жанри, які є в центральному фонді, але відсутні у філії)
SDIFF library:genres library:branch1:genres

# 6.8. Отримати випадковий елемент (рубрика «Рекомендований жанр дня»)
SRANDMEMBER library:genres

# 6.9. Видалити елемент з множини
SREM library:genres "філософія"

# 6.10. Отримати кількість елементів у множині
SCARD library:genres

# ==============================================================================
# ЗАВДАННЯ 7: Робота з хеш-таблицями (Hashes)
# ==============================================================================

# 7.1. Створити хеш картки книги з 7 полями різних типів
HSET library:book:101 title "Кобзар" author "Тарас Шевченко" year 1840 pages 115 price 350.50 isbn "978-966-03-8201-1" in_stock 1

# 7.2. Отримати значення окремих полів
HGET library:book:101 title
HGET library:book:101 price

# 7.3. Отримати всі поля та значення хеша
HGETALL library:book:101

# 7.4. Оновити кілька полів одночасно
HSET library:book:101 price 380.00 in_stock 0

# 7.5. Видалити одне поле
HDEL library:book:101 isbn

# 7.6. Перевірити існування поля
HEXISTS library:book:101 isbn
HEXISTS library:book:101 title

# 7.7. Отримати список усіх ключів (полів) хеша
HKEYS library:book:101

# 7.8. Отримати список усіх значень полів хеша
HVALS library:book:101

# 7.9. Збільшити числове поле в хеші (наприклад, додано додаток до книги на 10 сторінок)
HINCRBY library:book:101 pages 10

# 7.10. Отримати кількість полів у хеші
HLEN library:book:101

# ==============================================================================
# ЗАВДАННЯ 8: Робота з впорядкованими множинами (Sorted Sets)
# ==============================================================================

# 8.1. Створити впорядковану множину з 9 книг та їх кількістю видач (score)
ZADD library:popular_books 98 "Кобзар" 85 "Лісова пісня" 76 "Тіні забутих предків" 91 "Місто" 64 "Захар Беркут" 52 "Кайдашева сім'я" 70 "Чорна рада" 43 "Хіба ревуть воли" 88 "Енеїда"

# 8.2. Отримати топ-3 найпопулярніших книг (найвищі оцінки)
ZREVRANGE library:popular_books 0 2 WITHSCORES

# 8.3. Отримати 3 книги з найменшою кількістю видач
ZRANGE library:popular_books 0 2 WITHSCORES

# 8.4. Знайти позицію конкретної книги в рейтингу (зростання та спадання)
ZRANK library:popular_books "Лісова пісня"
ZREVRANK library:popular_books "Лісова пісня"

# 8.5. Отримати оцінку (кількість видач) конкретної книги
ZSCORE library:popular_books "Кобзар"

# 8.6. Збільшити оцінку елемента на довільне число (книгу взяли ще 7 разів)
ZINCRBY library:popular_books 7 "Лісова пісня"

# 8.7. Отримати кількість книг з кількістю видач у діапазоні від 70 до 95
ZCOUNT library:popular_books 70 95

# 8.8. Отримати книги за діапазоном оцінок від 70 до 95
ZRANGEBYSCORE library:popular_books 70 95 WITHSCORES

# 8.9. Видалити книгу з рейтингу (списання екземпляра)
ZREM library:popular_books "Хіба ревуть воли"

# 8.10. Отримати загальну кількість книг у рейтингу
ZCARD library:popular_books

# ==============================================================================
# ЗАВДАННЯ 9: Робота з JSON
# ==============================================================================

# 9.1-9.5. Збереження структурованого JSON-документа книги з відгуками
SET library:json:book:101 "{\"id\":101,\"title\":\"Кобзар\",\"author\":\"Тарас Шевченко\",\"year\":1840,\"in_stock\":true,\"genres\":[\"поезія\",\"класика\"],\"reviews\":[{\"reader_id\":1001,\"rating\":5,\"comment\":\"Невмируща українська класика\"},{\"reader_id\":1002,\"rating\":5,\"comment\":\"Чудове оформлення видання\"}]}"

# 9.2. Зчитування повного JSON-документа
GET library:json:book:101

# ==============================================================================
# ЗАВДАННЯ 10: Транзакції та пакетні операції
# ==============================================================================

# 10.1. Виконання серії команд як транзакції (MULTI/EXEC)
MULTI
SET library:announcement "Бібліотека переходить на літній графік"
INCR library:stat:daily_visitors
RPUSH library:events:log "Оголошення опубліковано"
EXEC

# 10.2. Виконання транзакції з відміною (MULTI/DISCARD)
MULTI
SET library:temp_flag "Помилкове значення"
INCRBY library:stat:daily_visitors 100
DISCARD

# 10.3. Пакетне створення 10 ключів книжкових стелажів (MSET)
MSET library:shelf:1 "Класична література" library:shelf:2 "Українська проза" library:shelf:3 "Поезія XIX ст." library:shelf:4 "Драматургія" library:shelf:5 "Історичні нариси" library:shelf:6 "Фольклор та міфологія" library:shelf:7 "Зарубіжна література" library:shelf:8 "Наукові монографії" library:shelf:9 "Періодичні видання" library:shelf:10 "Рідкісні та цінні книги"

# 10.4. Отримати значення кількох ключів одночасно (MGET)
MGET library:shelf:1 library:shelf:3 library:shelf:5 library:shelf:10

# 10.5. Атомарна операція «встановити якщо не існує» (SETNX)
SETNX library:admin:access_token "SECRET_LIBRARIAN_KEY_2026"
SETNX library:admin:access_token "ANOTHER_KEY_ATTEMPT"

# ==============================================================================
# ЗАВДАННЯ 11: Робота з шаблонами ключів та пошук
# ==============================================================================

# 11.1. Отримати список ключів у базі даних
KEYS library:name

# 11.2. Знайти ключі за шаблоном
KEYS library:shelf:*
KEYS library:stat:*

# 11.3. Отримати випадковий ключ
RANDOMKEY

# 11.4. Перейменувати ключ
RENAME library:announcement library:news:current

# 11.5. Безпечне ітеративне сканування (SCAN)
SCAN 0 MATCH library:* COUNT 10

# ==============================================================================
# ЗАВДАННЯ 12: Моніторинг та аналіз продуктивності
# ==============================================================================

# 12.1. Загальна інформація про сервер
INFO

# 12.2. Статистика роботи сервера
INFO stats

# 12.3. Перевірити використання памʼяті для конкретних ключів
MEMORY USAGE library:book:101
MEMORY USAGE library:popular_books

# 12.4. Загальна кількість ключів у базі даних
DBSIZE
